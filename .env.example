# Copie para .env e ajuste. O arquivo .env esta no .gitignore e nunca deve ser
# commitado. As chaves do Gemini (Etapa 3) e do Groq (Etapa 6) entram aqui e no
# painel do Render, e em nenhum outro lugar.

# --- Banco ---
DB_URL=jdbc:postgresql://localhost:5432/triagem
DB_USERNAME=triagem
DB_PASSWORD=triagem

# --- Gemini ---
# Gere em https://aistudio.google.com (Get API key). No plano gratuito, o Google
# pode usar o conteudo enviado para melhorar os modelos: nao envie dados reais.
GEMINI_API_KEY=coloque-a-sua-chave-aqui
GEMINI_MODELO=gemini-3.5-flash-lite
